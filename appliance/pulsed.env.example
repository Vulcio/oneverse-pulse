# Install a verified immutable engine bundle, writable only by the administrator.
PULSE_ENGINE_DIR=/opt/oneverse-pulse/engines/ONEVERSE_COMMIT_SHA
ONEVERSE_API_URL=https://api.oneverse.top
PULSE_NODE_ID=pulse-hall-1
PULSE_DATA_DIR=/var/lib/oneverse-pulse/engine
PULSE_ROOM_PORT=8788
# The room listens on the venue LAN by default, with the engine's signed passes.
# PULSE_ROOM_HOST=0.0.0.0
# PULSE_ROOM_URL=http://192.168.1.20:8788
