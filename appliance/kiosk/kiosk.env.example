# Oneverse's screen app uses existing pairing and theme rendering.
# The online default requires internet. Local live screens arrive in roadmap P2.
PULSE_SCREEN_URL=https://screen.oneverse.top
# Development (requires pulsed --dev): PULSE_SCREEN_URL=http://127.0.0.1:8787/screen
PULSE_CHROMIUM_PROFILE=/var/lib/oneverse-pulse/chromium
