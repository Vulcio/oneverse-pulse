# The upstream Songverse /screen route uses existing pairing and theme rendering.
# Change this to a local deployed Songverse web build when offline packaging exists.
SONGVERSE_SCREEN_URL=https://songverse.one/screen
# Development: SONGVERSE_SCREEN_URL=http://127.0.0.1:8787/screen
SONGVERSE_CHROMIUM_PROFILE=/var/lib/songverse/chromium
