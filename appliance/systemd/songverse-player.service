[Unit]
Description=Songverse Player daemon
After=network.target

[Service]
Type=simple
User=songverse
Group=songverse
ExecStart=/usr/local/bin/songverse-player
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
