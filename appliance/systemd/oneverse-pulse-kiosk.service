[Unit]
Description=Oneverse Pulse Chromium HDMI kiosk
After=systemd-user-sessions.service
Wants=systemd-user-sessions.service
# Run on a dedicated local VT, not concurrently with a desktop display manager.
Conflicts=display-manager.service

[Service]
Type=simple
User=pulse
Group=pulse
SupplementaryGroups=video render input
PAMName=login
WorkingDirectory=/var/lib/oneverse-pulse
EnvironmentFile=-/etc/oneverse-pulse/kiosk.env
UMask=0077
ExecStart=/usr/local/lib/oneverse-pulse/launch-kiosk.sh
Restart=always
RestartSec=3
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# Cage requires a logind session and graphics device access; validate on hardware.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
