[Unit]
Description=Songverse Chromium HDMI kiosk
After=systemd-user-sessions.service
Wants=systemd-user-sessions.service
# Run on a dedicated local VT, not concurrently with a desktop display manager.
Conflicts=display-manager.service

[Service]
Type=simple
User=songverse
Group=songverse
SupplementaryGroups=video render input
PAMName=login
WorkingDirectory=/var/lib/songverse
EnvironmentFile=-/etc/songverse/kiosk.env
ExecStart=/usr/local/lib/songverse/launch-kiosk.sh
Restart=always
RestartSec=3
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# Cage requires a logind session and graphics device access; validate on hardware.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
